# Nitro bind address inside the container. Keep HOST at 0.0.0.0 for Docker.
HOST=0.0.0.0

# Nitro bind port. Keep this in sync with SERVER_PORT and the port in ADVERTISED_BASE_URL.
PORT=34400

# Required: octopus-generated playlist URL.
M3U_URL=http://octopus.local:8888/playlist.m3u

# Required: exact LAN-reachable origin Plex should use. Must be origin-only, include an explicit port,
# and use an IPv4 address that belongs to the host running the bridge.
ADVERTISED_BASE_URL=http://192.168.1.50:34400

# Optional: defaults to a valid HDHomeRun-style ID. Override with a unique 8-character uppercase hexadecimal ID on your LAN.
HDHR_DEVICE_ID=105A1B22

# Optional: defaults to octotuner-<HDHR_DEVICE_ID>.
# HDHR_DEVICE_AUTH=octotuner-105A1B22

# Optional: friendly name Plex shows during tuner setup.
HDHR_FRIENDLY_NAME=octotuner

# Optional: advertised tuner count metadata.
HDHR_TUNER_COUNT=4

# Optional: playlist refresh interval in seconds.
PLAYLIST_REFRESH_SECONDS=300

# Optional: bridge config port. Must match PORT and ADVERTISED_BASE_URL.
SERVER_PORT=34400
